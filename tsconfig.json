{
  "compilerOptions": {
    "declaration": false,
    "target": "ES2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "src/js",
    "noImplicitAny": true,
    "noImplicitReturns": false,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "outDir": "dist/js",
    "removeComments": true,
    "esModuleInterop": true,
    "lib": ["dom", "ES2023"],
    "types": ["chrome"]
  },
  "include": ["src/js/*.ts"]
}
