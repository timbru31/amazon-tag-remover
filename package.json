{
  "name": "tag-remover-for-amazon",
  "version": "1.2.0",
  "private": true,
  "description": "WebExtension for Chrome, Firefox, Edge and Opera to remove the Amazon affiliate tracking ID (tag) from amazon links",
  "homepage": "https://github.com/timbru31/amazon-tag-remover#readme",
  "bugs": {
    "url": "https://github.com/timbru31/amazon-tag-remover/issues"
  },
  "license": "MIT",
  "author": "Tim Prüssing <github@timbrust.de>",
  "repository": "timbru31/amazon-tag-remover",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "postbuild": "tsx scripts/postbuild.ts",
    "lint:js": "oxlint src/js",
    "stylelint": "stylelint 'src/**/*.html'",
    "lint": "pnpm run lint:js && pnpm run stylelint && pnpm run fmt:check",
    "lint:swift": "swiftlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prerelease": "pnpm run test",
    "release": "commit-and-tag-version -s -a",
    "postrelease": "pnpm run build",
    "pretest": "pnpm run lint",
    "test": "echo soon!"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "@types/firefox-webext-browser": "^120.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "addons-linter": "^7.20.0",
    "commit-and-tag-version": "^12.6.1",
    "fs-extra": "^11.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^16.26.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recommended": "^15.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.16.1",
  "commit-and-tag-version": {
    "scripts": {
      "postbump": "tsx scripts/patch-versions.ts && oxfmt src/manifest.json && git add src/manifest.json",
      "postchangelog": "oxfmt CHANGELOG.md"
    }
  }
}
